# Server-only settings. Never prefix secrets with VITE_.
RESEND_API_KEY=
# Your private inbox that receives enquiries (one address).
CONTACT_TO_EMAIL=
# Use an address on your verified Resend domain.
CONTACT_FROM_EMAIL=
# Exact public origin, no path. Change this to your live HTTPS domain on deployment.
CONTACT_SITE_URL=http://localhost:5173
TURNSTILE_SECRET_KEY=

# Public values bundled into the site. Rebuild after changing these.
VITE_TURNSTILE_SITE_KEY=
# Optional public email override; blank uses info@dambadenibuilders.lk from the company profile.
VITE_CONTACT_EMAIL=
